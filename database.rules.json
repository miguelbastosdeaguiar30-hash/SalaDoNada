{"rules":{"rooms":{"$room":{
 ".read":"auth!=null",
 "meta":{".write":"auth!=null && !data.exists() && newData.child('host').val()===auth.uid",
  ".validate":"newData.hasChildren(['host','createdAt'])"},
 "players":{"$uid":{".write":"auth!=null && auth.uid===$uid",
  ".validate":"newData.hasChildren(['n','x','z','ry'])",
  "n":{".validate":"newData.isString() && newData.val().length<=16"},
  "x":{".validate":"newData.isNumber() && newData.val()>-200 && newData.val()<200"},
  "z":{".validate":"newData.isNumber() && newData.val()>-200 && newData.val()<200"},
  "y":{".validate":"newData.isNumber()"},"ry":{".validate":"newData.isNumber()"},
  "c":{".validate":"newData.isString() && newData.val().length<=7"},
  "e":{".validate":"newData.isString() && newData.val().length<=10"},"et":{".validate":"newData.isNumber()"},
  "$other":{".validate":"false"}}},
 "chat":{"$id":{".write":"auth!=null && !data.exists()",
  ".validate":"newData.child('u').val()===auth.uid && newData.child('m').isString() && newData.child('m').val().length<=200 && newData.child('n').val().length<=16"}}
}}}}
