{
 "rules": {
  "rooms": {
   "$room": {
    ".read": "auth!=null",
    "meta": {
     ".write": "auth!=null && !data.exists() && newData.child('host').val()===auth.uid",
     ".validate": "newData.hasChildren(['host','createdAt'])",
     "host": { ".validate": "newData.isString()" },
     "createdAt": { ".validate": "newData.isNumber()" },
     "$other": { ".validate": "false" }
    },
    "players": {
     "$uid": {
      ".write": "auth!=null && auth.uid===$uid",
      ".validate": "newData.hasChildren(['n','x','z','ry'])",
      "n": { ".validate": "newData.isString() && newData.val().length<=16" },
      "x": { ".validate": "newData.isNumber() && newData.val()>-600 && newData.val()<600" },
      "z": { ".validate": "newData.isNumber() && newData.val()>-600 && newData.val()<600" },
      "y": { ".validate": "newData.isNumber() && newData.val()>-10 && newData.val()<300" },
      "ry": { ".validate": "newData.isNumber()" },
      "c": { ".validate": "newData.isString() && newData.val().length<=7" },
      "e": { ".validate": "newData.isString() && newData.val().length<=10" },
      "f": { ".validate": "newData.isNumber()" },
      "a": { ".validate": "newData.isNumber()" },
      "fx": { ".validate": "newData.isNumber()" },
      "car": { ".validate": "newData.isNumber() && newData.val()>=-1 && newData.val()<24" },
      "v": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": "false" }
     }
    },
    "cars": {
     "$i": {
      ".write": "auth!=null && (!data.exists() || data.child('o').val()===auth.uid || data.child('d').val()===auth.uid || (!data.child('d').exists() && newData.child('d').val()===auth.uid))",
      ".validate": "$i.matches(/^(1?[0-9]|2[0-3])$/) && newData.hasChildren(['x','z','ry'])",
      "x": { ".validate": "newData.isNumber() && newData.val()>-600 && newData.val()<600" },
      "z": { ".validate": "newData.isNumber() && newData.val()>-600 && newData.val()<600" },
      "ry": { ".validate": "newData.isNumber()" },
      "d": { ".validate": "newData.isString()" },
      "o": { ".validate": "newData.isString()" },
      "$other": { ".validate": "false" }
     }
    },
    "boxes": {
     "$i": {
      ".write": "auth!=null",
      ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['x','z'])",
      "x": { ".validate": "newData.isNumber() && newData.val()>-100 && newData.val()<100" },
      "z": { ".validate": "newData.isNumber() && newData.val()>-100 && newData.val()<100" },
      "ry": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": "false" }
     }
    },
    "chat": {
     "$id": {
      ".write": "auth!=null && !data.exists()",
      ".validate": "newData.hasChildren(['u','n','m','t']) && newData.child('u').val()===auth.uid && newData.child('m').isString() && newData.child('m').val().length<=200 && newData.child('n').isString() && newData.child('n').val().length<=16 && newData.child('t').val()===now",
      "u": { ".validate": "newData.isString()" },
      "n": { ".validate": "newData.isString()" },
      "m": { ".validate": "newData.isString()" },
      "t": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": "false" }
     }
    },
    "ev": {
     "$id": {
      ".write": "auth!=null && (!data.exists() || data.child('u').val()===auth.uid)",
      ".validate": "newData.hasChildren(['u','t','x','z','ts']) && newData.child('u').val()===auth.uid",
      "u": { ".validate": "newData.isString()" },
      "t": { ".validate": "newData.isString() && newData.val().length<=4" },
      "x": { ".validate": "newData.isNumber() && newData.val()>-600 && newData.val()<600" },
      "z": { ".validate": "newData.isNumber() && newData.val()>-600 && newData.val()<600" },
      "y": { ".validate": "newData.isNumber() && newData.val()>-10 && newData.val()<300" },
      "a": { ".validate": "newData.isNumber()" },
      "s": { ".validate": "newData.isString() && newData.val().length<=16" },
      "ts": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": "false" }
     }
    },
    "houses": {
     "$uid": {
      ".write": "auth!=null && auth.uid===$uid",
      ".validate": "newData.hasChildren(['x','z','s','oc','rc','ic','fc','n'])",
      "x": { ".validate": "newData.isNumber()" },
      "z": { ".validate": "newData.isNumber()" },
      "s": { ".validate": "newData.isNumber() && newData.val()>=0 && newData.val()<64" },
      "n": { ".validate": "newData.isString() && newData.val().length<=16" },
      "oc": { ".validate": "newData.isString() && newData.val().length<=7" },
      "rc": { ".validate": "newData.isString() && newData.val().length<=7" },
      "ic": { ".validate": "newData.isString() && newData.val().length<=7" },
      "fc": { ".validate": "newData.isString() && newData.val().length<=7" },
      "$other": { ".validate": "false" }
     }
    }
   }
  },
  "sig": {
   "$room": {
    "$to": {
     ".read": "auth!=null && auth.uid===$to",
     ".write": "auth!=null && auth.uid===$to",
     "$from": {
      ".write": "auth!=null && auth.uid===$from"
     }
    }
   }
  }
 }
}
