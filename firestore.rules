rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  match /users/{uid} {
    allow read: if request.auth != null && request.auth.uid == uid;
    // Moedas iniciais fixas; cliente NÃO pode alterar coins/inventário/conquistas.
    allow create: if request.auth != null && request.auth.uid == uid
      && request.resource.data.coins == 100
      && request.resource.data.username is string && request.resource.data.username.size() <= 16;
    allow update: if request.auth != null && request.auth.uid == uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','equippedColor','lastLogin','settings']);
    allow delete: if false;
  }
}}
